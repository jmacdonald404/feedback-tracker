datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth.js Models ──────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)

  accounts      Account[]
  sessions      Session[]
  posts         FeedbackPost[] @relation("Author")
  assignedPosts FeedbackPost[] @relation("Assignee")
  comments      Comment[]
  votes         Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ──────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Category {
  BUG
  FEATURE
  IMPROVEMENT
}

enum Status {
  NEW
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

model FeedbackPost {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  category     Category
  status       Status   @default(NEW)
  isPublished  Boolean  @default(false)
  contactEmail String?
  voteCount    Int      @default(0)

  authorId   String?
  author     User?   @relation("Author", fields: [authorId], references: [id])
  assigneeId String?
  assignee   User?   @relation("Assignee", fields: [assigneeId], references: [id])

  mergedIntoId String?
  mergedInto   FeedbackPost?  @relation("MergedPosts", fields: [mergedIntoId], references: [id])
  mergedPosts  FeedbackPost[] @relation("MergedPosts")

  comments Comment[]
  votes    Vote[]
  tags     Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([isPublished, status])
  @@index([voteCount(sort: Desc)])
}

model Comment {
  id           String  @id @default(cuid())
  content      String  @db.Text
  isStaffReply Boolean @default(false)

  postId   String
  post     FeedbackPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User         @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

model Vote {
  id String @id @default(cuid())

  postId String
  post   FeedbackPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model Tag {
  id    String         @id @default(cuid())
  name  String         @unique
  posts FeedbackPost[]
}
